{
  "module": {
    "mounts": [
      { "source": "layouts", "target": "layouts" },
      { "source": "static", "target": "static" },
      { "source": "static/assets", "target": "assets" },
      { "source": "data", "target": "data" }
    ]
  },
  "outputFormats": {
    "llmstxt": {
      "mediaType": "text/plain",
      "baseName": "llms",
      "isPlainText": true,
      "notAlternative": true
    }
  },
  "outputs": {
    "home": [
      "HTML",
      "RSS",
      "JSON",
      "RSD",
      "ArchiveHTML",
      "ArchiveJSON",
      "PhotosHTML",
      "PhotosJSON",
      "PodcastXML",
      "PodcastJSON",
      "llmstxt"
    ]
  },
  "params": {
    "contentTypeName": "post",
    "showReadingTime": true,
    "showPostMeta": true,
    "pagefindEnabled": true,
    "search_path": "/search/",
    "llmsTxtEnabled": true,
    "llmstxt_recent": 50,
    "sites_include": [],
    "signup_sites": [],
    "tinylytics_id": "dMNzEVG73Bcq1RisbGRG",
    "tinylytics_options": "hits&kudos=👍&uptime&webring=avatars&countries&publicstats"
  }
}
